{
  "name": "blocktide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Blocktide — a small browser voxel sandbox in the spirit of 2009-era creative block building.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "vite build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
